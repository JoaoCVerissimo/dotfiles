{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.netrc)",
      "Read(//**/.config/gh/hosts.yml)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *-fu*)",
      "Bash(git push *-uf*)",
      "Bash(git push *+*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "basecamp": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "basecamp@37signals": false,
    "vercel@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "mods@jv-mods": true,
    "flow@jv-mods": true,
    "look@jv-mods": true,
    "keepwarm@jv-mods": true,
    "reflect@jv-mods": true,
    "next-steps@claude-community": true,
    "blast-radius@claude-code-playground-mods": false,
    "cc-plugin-you-should-know@builtin": false,
    "peek@jv-mods": true
  },
  "extraKnownMarketplaces": {
    "37signals": {
      "source": {
        "source": "github",
        "repo": "basecamp/claude-plugins"
      }
    },
    "jv-mods": {
      "source": {
        "source": "directory",
        "path": "~/Developer/dotfiles/.claude/mods"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community",
        "sparsePaths": [
          ".claude-plugin",
          "next-steps"
        ]
      }
    },
    "claude-code-playground-mods": {
      "source": {
        "source": "directory",
        "path": "~/.local/share/claude-code-playground/claude-code/mods"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "mods@jv-mods": {
      "options": {
        "alertSound": "Glass"
      }
    },
    "flow@jv-mods": {
      "options": {
        "band": "full",
        "autoOpen": false
      }
    },
    "look@jv-mods": {
      "options": {
        "skinsAuto": false
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
